---
// The launch film. Poster and one play button; it only loads and plays, with sound, when
// the visitor asks. Native controls appear once it starts.
import { url } from '../lib/site';

interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
---
<figure class:list={['film', cls]} data-film>
  <video
    width="1920"
    height="1080"
    playsinline
    preload="none"
    poster={url('/media/launch-poster.jpg')}
    aria-label="Vuoom launch film, about two minutes"
  >
    <source src={url('/media/launch.mp4')} type="video/mp4" />
  </video>
  <button class="film__play" type="button" data-film-play>
    <span class="film__pill">
    <span class="film__icon" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 20 20"><path d="M6.5 4.2v11.6L16 10z" fill="currentColor" /></svg>
    </span>
    <span class="film__label">Watch the film <span class="film__len">2 min</span></span>
    </span>
  </button>
</figure>

<style>
  .film {
    position: relative;
    border-radius: var(--r-frame);
    overflow: hidden;
    background: var(--ground-raised);
    box-shadow:
      var(--shadow-stage),
      0 0 0 var(--hair) var(--rule);
  }
  video {
    width: 100%;
  }
  .film__play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    padding: var(--s-5);
    background: linear-gradient(to top, rgb(11 11 12 / 0.55), transparent 45%);
  }
  .film__play > * {
    position: relative;
  }
  .film__pill {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    padding: 6px 18px 6px 6px;
    border-radius: var(--r-pill);
    background: rgb(22 22 24 / 0.8);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: inset 0 0 0 1px rgb(242 240 235 / 0.1);
  }
  .film__icon {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    padding-left: 2px;
    border-radius: var(--r-pill);
    background: var(--rec);
    color: var(--on-rec);
    
    transition: transform var(--dur-hover) var(--ease-out-quart);
  }
  .film__play:hover .film__icon {
    transform: scale(1.06);
  }
  .film__play:active .film__icon {
    transform: scale(0.97);
  }
  .film__label {
    font-weight: 560;
    color: var(--ink);
  }
  .film__len {
    color: var(--ink-2);
    font-weight: 400;
    margin-left: var(--s-2);
  }
  .film.is-playing .film__play {
    display: none;
  }
  @media (max-width: 560px) {
    .film__icon {
      width: 40px;
      height: 40px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-film]').forEach((fig) => {
    const v = fig.querySelector('video')!;
    fig.querySelector('[data-film-play]')?.addEventListener('click', () => {
      fig.classList.add('is-playing');
      v.controls = true;
      v.preload = 'auto';
      v.play().catch(() => {});
      v.focus();
    });
  });
</script>
