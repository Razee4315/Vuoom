---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SITE, url } from '../lib/site';

interface Props {
  path: string;
}
const { path } = Astro.props;
const links = [
  { href: '/features/', label: 'Features' },
  { href: '/compare/', label: 'Compare' },
  { href: '/guide/', label: 'Guide' },
  { href: '/changelog/', label: 'Changelog' },
];
---
<header class="nav" data-nav>
  <div class="nav__pill">
    <a class="nav__brand" href={url('/')} aria-label="Vuoom home">
      <Logo size={36} tile />
      <span class="nav__word">Vuoom</span>
    </a>

    <nav class="nav__links" aria-label="Main">
      {links.map((l) => (
        <a
          class="nav__link"
          href={url(l.href)}
          aria-current={path.startsWith(l.href) ? 'page' : undefined}
        >
          {l.label}
          <span class="nav__link-dot" aria-hidden="true"></span>
        </a>
      ))}
    </nav>

    <div class="nav__actions">
      <a class="nav__stars" href={SITE.repoUrl} rel="noopener" aria-label="Vuoom on GitHub">
        <Icon name="github" size={16} />
        <span class="nav__stars-n mono" data-stars hidden></span>
      </a>

      <button
        class="theme-toggle"
        type="button"
        aria-label="Switch to light theme"
        aria-pressed="false"
        data-theme-toggle
        title="Toggle Darkroom / Daylight studio"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <g class="theme-sun">
            <circle cx="12" cy="12" r="3.6" />
            <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
          </g>
          <path class="theme-moon" d="M20.6 14.2A9 9 0 0 1 9.8 3.4a9 9 0 1 0 10.8 10.8Z" />
        </svg>
        <span class="theme-tooltip" aria-hidden="true">Studio lighting</span>
      </button>

      <a class="nav__dl" href={url('/download/')}>
        <span>Download</span>
        <Icon name="download" size={15} />
      </a>

      <button
        class="nav__menu"
        type="button"
        aria-expanded="false"
        aria-controls="menu"
        aria-label="Menu"
        data-menu-toggle
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
          <path class="menu-top" d="M5 8h14" />
          <path class="menu-bottom" d="M5 16h14" />
        </svg>
      </button>
    </div>
  </div>

  <div class="sheet" id="menu" hidden data-menu>
    <nav aria-label="Mobile">
      <span class="sheet__label mono">VUOOM STUDIO ROUTES</span>
      {[{ href: '/', label: 'Home' }, ...links, { href: '/shortcuts/', label: 'Shortcuts' }, { href: '/faq/', label: 'FAQ' }, { href: '/download/', label: 'Download' }].map((l, i) => (
        <a href={url(l.href)} style={`--menu-index:${i}`}>
          <span class="mono">{String(i + 1).padStart(2, '0')}</span>
          {l.label}
          <span aria-hidden="true">↗</span>
        </a>
      ))}
      <p>Windows 10/11 &amp; macOS 14+ · Free under Apache-2.0</p>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: var(--s-4);
    inset-inline: 0;
    z-index: var(--z-nav);
    padding-inline: var(--gutter);
    pointer-events: none;
  }
  .nav__pill {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--s-4);
    max-width: var(--nav-max);
    height: 64px;
    padding: var(--s-2) var(--s-3) var(--s-2) var(--s-4);
    margin: auto;
    background: var(--nav-glass);
    border: var(--hair) solid var(--nav-rule);
    border-radius: var(--r-pill);
    box-shadow: var(--nav-shadow);
    backdrop-filter: blur(22px) saturate(1.2);
    -webkit-backdrop-filter: blur(22px) saturate(1.2);
    pointer-events: auto;
    transition:
      transform var(--nav-compact-duration) var(--ease-studio),
      max-width var(--nav-compact-duration) var(--ease-studio),
      height var(--nav-compact-duration) var(--ease-studio),
      padding var(--nav-compact-duration) var(--ease-studio),
      background-color var(--dur-fade) var(--ease-studio);
  }
  :global(.is-scrolled) .nav__pill {
    max-width: var(--nav-max-compact);
    height: var(--nav-h-compact);
    padding-block: var(--s-1);
    transform: translateY(-2px);
  }
  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    margin-right: auto;
    --logo-ink: #f6efe5;
  }
  .nav__brand :global(svg) {
    flex: none;
    transition:
      width var(--nav-compact-duration) var(--ease-studio),
      height var(--nav-compact-duration) var(--ease-studio),
      transform var(--nav-compact-duration) var(--ease-studio);
  }
  :global(.is-scrolled) .nav__brand :global(svg) {
    width: var(--nav-logo-compact);
    height: var(--nav-logo-compact);
  }
  .nav__brand:hover :global(svg) {
    transform: rotate(-6deg);
  }
  .nav__word {
    font: 750 22px var(--font-display);
    letter-spacing: -0.045em;
    transition: font-size var(--nav-compact-duration) var(--ease-studio);
  }
  :global(.is-scrolled) .nav__word {
    font-size: var(--nav-word-compact);
  }
  .nav__links,
  .nav__actions {
    display: flex;
    align-items: center;
    gap: var(--s-1);
  }
  .nav__link {
    position: relative;
    padding: 8px 14px;
    font-size: 13px;
    color: var(--ink-2);
    border-radius: var(--r-pill);
    transition: color var(--dur-hover) var(--ease-studio);
  }
  .nav__link::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--wash);
    opacity: 0;
    transform: scale(0.92);
    transition: transform var(--dur-hover) var(--ease-studio), opacity var(--dur-hover) var(--ease-studio);
  }
  .nav__link:hover,
  .nav__link[aria-current='page'] {
    color: var(--ink);
  }
  .nav__link:hover::before,
  .nav__link[aria-current='page']::before {
    opacity: 1;
    transform: scale(1);
  }
  .nav__link-dot {
    position: absolute;
    bottom: 3px;
    left: calc(50% - 2px);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--rec);
    transform: scale(0);
    transition: transform var(--dur-hover) var(--ease-studio);
  }
  .nav__link:hover .nav__link-dot,
  .nav__link[aria-current='page'] .nav__link-dot {
    transform: scale(1);
  }
  .nav__stars {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding-inline: 11px;
    border-radius: var(--r-pill);
    color: var(--ink-2);
    border: var(--hair) solid var(--rule);
    font-size: 12px;
    transition:
      color var(--dur-hover) var(--ease-studio),
      border-color var(--dur-hover) var(--ease-studio),
      background-color var(--dur-hover) var(--ease-studio);
  }
  .nav__stars:hover {
    color: var(--ink);
    background: var(--wash);
    border-color: var(--rule-strong);
  }
  .nav__stars-n:not([hidden]) {
    display: inline;
  }
  .nav__dl {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding-inline: 18px;
    margin-left: var(--s-1);
    background: var(--rec-fill);
    color: var(--on-rec);
    font-size: 13px;
    font-weight: 600;
    border-radius: var(--r-pill);
    box-shadow: inset 0 1px 0 rgb(255 245 235 / 0.25);
    transition:
      background-color var(--dur-hover) var(--ease-studio),
      transform var(--dur-control) var(--ease-studio);
  }
  .nav__dl:hover {
    background: var(--rec);
  }
  .nav__dl:active {
    transform: scale(0.98);
  }
  .nav__dl :global(svg) {
    transition: transform var(--dur-hover) var(--ease-studio);
  }
  .nav__dl:hover :global(svg) {
    transform: translateY(2px);
  }
  .theme-toggle,
  .nav__menu {
    position: relative;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--ink-2);
    transition:
      background-color var(--dur-hover) var(--ease-studio),
      color var(--dur-hover) var(--ease-studio);
  }
  .theme-toggle:hover,
  .nav__menu:hover {
    background: var(--wash);
    color: var(--ink);
  }
  .theme-toggle svg {
    overflow: visible;
  }
  .theme-sun,
  .theme-moon {
    transform-origin: center;
    transition: transform 360ms var(--ease-studio), opacity 220ms;
  }
  .theme-sun {
    opacity: 0;
    transform: rotate(90deg) scale(0.35);
  }
  .theme-moon {
    opacity: 1;
    transform: none;
  }
  :global([data-theme='light']) .theme-moon {
    opacity: 0;
    transform: rotate(-65deg) scale(0.35);
  }
  :global([data-theme='light']) .theme-sun {
    opacity: 1;
    transform: none;
  }
  .theme-tooltip {
    position: absolute;
    top: calc(100% + 14px);
    right: 0;
    padding: 6px 10px;
    background: var(--ground-raised);
    color: var(--ink);
    border: var(--hair) solid var(--rule-strong);
    font-size: 11px;
    border-radius: var(--r-ui);
    white-space: nowrap;
    opacity: 0;
    transform: translateY(-4px);
    pointer-events: none;
    transition: opacity 180ms, transform 180ms;
  }
  .theme-toggle:hover .theme-tooltip,
  .theme-toggle:focus-visible .theme-tooltip {
    opacity: 1;
    transform: none;
  }
  .nav__menu {
    display: none;
  }
  .menu-top,
  .menu-bottom {
    transform-origin: center;
    transition: transform 240ms var(--ease-studio);
  }
  [aria-expanded='true'] .menu-top {
    transform: translateY(4px) rotate(45deg);
  }
  [aria-expanded='true'] .menu-bottom {
    transform: translateY(-4px) rotate(-45deg);
  }
  .sheet {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: var(--ground);
    display: grid;
    place-items: center;
    padding: 96px var(--s-5) var(--s-6);
    pointer-events: auto;
    overflow-y: auto;
  }
  .sheet[hidden] {
    display: none;
  }
  .sheet nav {
    width: 100%;
    max-width: 440px;
  }
  .sheet__label {
    font-size: 10px;
    color: var(--tungsten);
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: var(--s-3);
  }
  .sheet a {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    padding-block: 14px;
    border-bottom: var(--hair) solid var(--rule);
    font: 620 var(--step-2) var(--font-display);
  }
  .sheet a > span:first-child {
    font-size: 11px;
    color: var(--rec-ink);
  }
  .sheet a > span:last-child {
    margin-left: auto;
    color: var(--ink-3);
    font-size: 20px;
  }
  .sheet p {
    margin-top: var(--s-5);
    color: var(--ink-3);
    font-size: 13px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .sheet:not([hidden]) nav {
      animation: menu-in 260ms var(--ease-studio) both;
    }
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (max-width: 1020px) {
    .nav__stars {
      display: none;
    }
  }
  @media (max-width: 820px) {
    .nav {
      top: var(--s-3);
      padding-inline: var(--s-3);
    }
    .nav__pill {
      height: 58px;
      padding: var(--s-2) var(--s-2) var(--s-2) var(--s-3);
      gap: 0;
    }
    .nav__links {
      display: none;
    }
    .nav__menu {
      display: grid;
    }
    .nav__word {
      font-size: 20px;
    }
    .nav__dl {
      padding-inline: 14px;
      margin-left: 0;
      height: 38px;
    }
    .nav__dl :global(svg) {
      display: none;
    }
    .nav__actions {
      gap: 2px;
    }
  }
  @media (max-width: 360px) {
    .nav__brand :global(svg) {
      width: 28px;
      height: 28px;
    }
    .nav__word {
      font-size: 18px;
    }
    .nav__dl {
      padding-inline: 11px;
      font-size: 12px;
    }
    .theme-toggle,
    .nav__menu {
      width: 36px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav__pill,
    .nav__word,
    .nav__brand :global(svg),
    .theme-sun,
    .theme-moon {
      transition: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const updateTheme = (theme: string) => {
    const isLight = theme === 'light';
    document.documentElement.dataset.theme = isLight ? 'light' : 'dark';
    toggle?.setAttribute('aria-pressed', String(isLight));
    toggle?.setAttribute('aria-label', isLight ? 'Switch to darkroom theme' : 'Switch to daylight studio theme');
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', isLight ? '#f4f0e8' : '#110f0e');
    document.querySelector('meta[name="color-scheme"]')?.setAttribute('content', isLight ? 'light' : 'dark');
  };
  updateTheme(document.documentElement.dataset.theme || 'dark');

  let transition: { skipTransition(): void } | undefined;
  toggle?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    transition?.skipTransition();
    if (document.startViewTransition && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      transition = document.startViewTransition(() => updateTheme(next));
    } else {
      updateTheme(next);
    }
    try {
      localStorage.setItem('vuoom-theme', next);
    } catch {}
    window.dispatchEvent(new CustomEvent('vuoom:theme', { detail: { theme: next } }));
  });

  window.addEventListener('storage', (event) => {
    if (event.key === 'vuoom-theme') {
      updateTheme(event.newValue === 'light' ? 'light' : 'dark');
    }
  });
</script>
