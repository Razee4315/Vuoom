---
// Framed genuine product screenshot/still, never dummy code-bar placeholders.
import { Image } from 'astro:assets';
import home from '../assets/shots/screenshot-home.png';
import flat from '../assets/shots/take-flat.png';
import zoom from '../assets/shots/take-zoom.png';

const SHOTS = {
  home: { src: home, alt: "Vuoom's home screen with Region, Full screen, Window and crash recovery options" },
  flat: { src: flat, alt: 'Full-screen capture of the Aurora 2.4 launch dashboard at 1x scale' },
  zoom: { src: zoom, alt: 'Vuoom auto-zoom locked smoothly onto the Aurora 2.4 sign-up counter' },
} as const;

interface Props {
  name: keyof typeof SHOTS;
  sizes?: string;
  eager?: boolean;
  class?: string;
  alt?: string;
}
const { name, sizes = '(min-width: 960px) 50vw, 100vw', eager = false, class: cls, alt } = Astro.props;
const s = SHOTS[name] ?? SHOTS.zoom;
---
<div class:list={['shot', cls]}>
  <Image
    src={s.src}
    alt={alt ?? s.alt}
    widths={[480, 800, 1200, 1600]}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
  />
</div>
<style>
  .shot {
    border-radius: var(--r-frame);
    overflow: hidden;
    background: var(--ground-well);
    border: var(--hair) solid var(--rule-strong);
    box-shadow: var(--shadow-stage), inset 0 1px 0 var(--rim);
  }
  .shot :global(img) {
    width: 100%;
    height: auto;
  }
</style>
