---
// A real Vuoom take. Never autoplays at rest when deferred or under reduced motion;
// attaches source on demand when explicit Play is used or when visible in Screening Room.
import { url } from '../lib/site';
import Icon from './Icon.astro';

const CLIPS = {
  demo: { w: 1600, h: 900, label: 'A dashboard recording where the camera zooms into each click' },
  github: { w: 1000, h: 562, label: 'Zooming into a GitHub page in a browser, with motion blur' },
  voice: { w: 1000, h: 562, label: 'The Vuoom README recorded with captions reading "I am using Vuoom"' },
} as const;

interface Props {
  name: keyof typeof CLIPS;
  class?: string;
  sound?: boolean;
  deferSource?: boolean;
}
const { name, class: cls, sound = false, deferSource = false } = Astro.props;
const c = CLIPS[name];
const srcUrl = url(`/media/${name}.mp4`);
---
<figure class:list={['vid', cls]} data-video={deferSource ? 'demand' : 'auto'}>
  <video
    width={c.w}
    height={c.h}
    muted
    loop
    playsinline
    preload="none"
    poster={url(`/media/${name}-poster.jpg`)}
    data-src={deferSource ? srcUrl : undefined}
    aria-label={c.label}
  >
    {!deferSource && <source src={srcUrl} type="video/mp4" />}
  </video>
  <div class="vid__bar">
    <button class="vid__btn" type="button" data-video-toggle aria-pressed="false">
      <span class="vid__play"><Icon name="play" size={14} /><span class="visually-hidden">Play</span></span>
      <span class="vid__pause"><Icon name="pause" size={14} /><span class="visually-hidden">Pause</span></span>
    </button>
    {sound && (
      <button class="vid__btn vid__sound mono" type="button" data-video-sound aria-pressed="false">
        Sound off
      </button>
    )}
  </div>
</figure>
