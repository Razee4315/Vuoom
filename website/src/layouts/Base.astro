---
// The shell every page renders in: full SEO head, structured data, header, footer, grain,
// and the progressively enhanced motion runtime.
import '../styles/global.css';
import '../styles/paper-shared.css';
import geist from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { PAGES, ogSlug, type PagePath } from '../data/pages';
import { SITE, absolute, url } from '../lib/site';
import { latest } from '../lib/github';

interface Props {
  path: PagePath;
  crumbs?: { href: string; label: string }[];
  schema?: Record<string, unknown>[];

  type?: 'website' | 'article';
}

const { path, crumbs, schema = [], type = 'website' } = Astro.props;
const meta = PAGES[path];
const canonical = absolute(path === '/404/' ? '/' : path);
const og = absolute(`/og/${ogSlug(path)}.png`);
const release = await latest();

const org = {
  '@type': 'Organization',
  '@id': `${absolute('/')}#org`,
  name: SITE.name,
  url: absolute('/'),
  logo: absolute('/icon-512.png'),
  sameAs: [SITE.repoUrl],
};
const website = {
  '@type': 'WebSite',
  '@id': `${absolute('/')}#website`,
  name: SITE.name,
  url: absolute('/'),
  description: SITE.description,
  publisher: { '@id': `${absolute('/')}#org` },
  inLanguage: 'en',
};
const breadcrumbLd = crumbs?.length
  ? {
      '@type': 'BreadcrumbList',
      itemListElement: [{ href: '/', label: 'Home' }, ...crumbs].map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.label,
        item: absolute(c.href),
      })),
    }
  : undefined;
const graph = {
  '@context': 'https://schema.org',
  '@graph': [org, website, ...(breadcrumbLd ? [breadcrumbLd] : []), ...schema],
};
const fullTitle = path === '/' ? meta.title : `${meta.title} | Vuoom`;
---
<!doctype html>
<html lang="en" dir="ltr" data-version={release.version}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={canonical} />
    {path === '/404/' ? <meta name="robots" content="noindex" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="color-scheme" content="light" />
    <meta name="application-name" content="Vuoom" />
    <meta name="author" content={SITE.author} />
    <meta name="generator" content={Astro.generator} />
    {SITE.gscVerification && <meta name="google-site-verification" content={SITE.gscVerification} />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Vuoom" />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${meta.og} Vuoom, the free auto-zoom screen recorder for Windows.`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={og} />

    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="manifest" href={url('/manifest.webmanifest')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <link rel="alternate" type="application/atom+xml" title="Vuoom releases" href={`${SITE.releasesUrl}.atom`} />

    <link rel="preload" href={geist} as="font" type="font/woff2" crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />

    <script is:inline>
      // Read the accessibility preference before initializing optional motion.
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var savedTheme = null;
        try { savedTheme = localStorage.getItem('vuoom-theme'); } catch (e) {}
        d.dataset.theme = savedTheme === 'dark' || savedTheme === 'light'
          ? savedTheme
          : window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduce) d.classList.add('motion');

      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <Header path={path} />
    <main id="content" tabindex="-1">
      {crumbs && (
        <div class="wrap crumbs-wrap">
          <Breadcrumbs items={crumbs} />
        </div>
      )}
      <slot />
    </main>
    <Footer release={release} />
    <div class="grain" aria-hidden="true"></div>

    <script>
      import '../scripts/main';
    </script>
  </body>
</html>

<style>
  .skip {
    position: fixed;
    left: var(--s-4);
    top: var(--s-4);
    z-index: calc(var(--z-countdown) + 1);
    padding: var(--s-3) var(--s-4);
    background: var(--ink);
    color: var(--ground);
    border-radius: var(--r-ui);
    transform: translateY(-200%);
    transition: transform var(--dur-hover) var(--ease-out);
  }
  .skip:focus {
    transform: none;
  }
  main {
    position: relative;
    z-index: 1;
    background: var(--ground);
    outline: none;
  }
  .crumbs-wrap {
    padding-top: calc(var(--nav-h) + var(--s-7));
  }

</style>
