---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { marked } from 'marked';
import { releases, humanDate } from '../lib/github';
import { SITE } from '../lib/site';

const list = (await releases()).slice(0, 20);
const render = (md: string) => marked.parse(md.replace(/\r\n/g, '\n'), { async: false }) as string;
---
<Base path="/changelog/" crumbs={[{ href: '/changelog/', label: 'Changelog' }]}>
  <PageHead title="What changed." sub="Every release, newest first. Vuoom updates itself from inside the app." />

  <div class="wrap narrow">
    <ol class="log" role="list">
      {list.map((r) => (
        <li class="log__item" id={`v${r.version}`}>
          <div class="log__meta">
            <a class="log__v" href={`#v${r.version}`}>v{r.version}</a>
            <time datetime={r.date}>{humanDate(r.date)}</time>
          </div>
          <div class="log__body prose">
            {r.body ? <Fragment set:html={render(r.body)} /> : <p>Maintenance release. <a href={r.url} rel="noopener">Details on GitHub</a>.</p>}
          </div>
        </li>
      ))}
    </ol>
    <p class="older">Older releases are on <a class="link" href={SITE.releasesUrl} rel="noopener">GitHub</a>.</p>
  </div>
</Base>

<style>
  .narrow {
    max-width: calc(960px + var(--gutter) * 2);
    padding-bottom: var(--section);
  }
  .log__item {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: var(--s-6);
    padding-block: var(--s-8);
    box-shadow: inset 0 1px 0 var(--rule);
    scroll-margin-top: 120px;
  }
  .log__meta {
    display: grid;
    align-content: start;
    gap: var(--s-1);
  }
  .log__v {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
    font-stretch: 92%;
    letter-spacing: var(--track-heading);
  }
  time {
    color: var(--ink-3);
    font-size: 0.875rem;
  }
  .log__body :global(h1),
  .log__body :global(h2) {
    font-size: var(--step-1);
    margin-top: var(--s-6);
  }
  .log__body :global(h1:first-child),
  .log__body :global(h2:first-child),
  .log__body :global(h3:first-child) {
    margin-top: 0;
  }
  .older {
    padding-top: var(--s-7);
    box-shadow: inset 0 1px 0 var(--rule);
    color: var(--ink-3);
  }
  @media (max-width: 720px) {
    .log__item {
      grid-template-columns: 1fr;
      gap: var(--s-4);
    }
  }
</style>
