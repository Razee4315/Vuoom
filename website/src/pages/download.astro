---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Button from '../components/Button.astro';
import Film from '../components/Film.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import { SITE, url } from '../lib/site';
import { latest, mb, humanDate } from '../lib/github';
import { softwareApp, faqPage } from '../lib/schema';

const r = await latest();
const exe = r.exe;
const msi = r.msi;
const dmg = r.dmg;
const faq = [
  {
    q: 'Why does SmartScreen or Gatekeeper warn me?',
    a: 'Installers are not signed with paid certificates yet. On Windows click More info, then Run anyway. On macOS right-click Vuoom in Applications and click Open once. Every binary is compiled publicly by GitHub Actions.',
  },
  {
    q: 'Which file should I pick on Windows?',
    a: 'The .exe for most people. The .msi suits managed or company machines. Both install the same app.',
  },
  {
    q: 'How do macOS permissions work?',
    a: 'macOS asks once for Screen Recording (needed to capture video) and Accessibility (so Auto zooms sees clicks and hotkeys stay out of recorded apps). Vuoom Home guides you with direct toggles.',
  },
  {
    q: 'How do I update?',
    a: 'Vuoom checks GitHub Releases when it starts. When a new version is out, an Update button appears in the top bar. Nothing installs until you click it.',
  },
];
---
<Base path="/download/" crumbs={[{ href: '/download/', label: 'Download' }]} schema={[await softwareApp(), faqPage(faq)]}>
  <PageHead
    eyebrow={`Version ${r.version}${r.date ? ` · ${humanDate(r.date)}` : ''}`}
    title="Download Vuoom."
    sub="Free and open source for Windows 10/11 and macOS 14+ Apple Silicon. No account, no watermark."
  />

  <div class="wrap narrow">
    <aside class="elsewhere studio-surface" data-not-desktop hidden aria-labelledby="elsewhere-h">
      <h2 id="elsewhere-h" class="h4">On a phone or tablet right now?</h2>
      <p>Vuoom runs natively on Windows 10/11 and macOS 14+. Star it on GitHub or copy this link to open on your computer.</p>
      <div class="elsewhere-actions">
        <Button href={SITE.repoUrl} variant="secondary" icon="star">Star on GitHub <span data-stars hidden></span></Button>
        <button type="button" class="link" data-copy-link data-copied="Link copied">Copy the link</button>
      </div>
    </aside>

    <div class="platforms">
      <section class="plat-card studio-surface" aria-labelledby="win-h">
        <div class="plat-card__head">
          <span class="plat-card__icon"><Icon name="windows" size={20} /></span>
          <div>
            <h2 id="win-h" class="h4">Windows 10 &amp; 11</h2>
            <p class="mono">64-BIT · WGC + MEDIA FOUNDATION</p>
          </div>
        </div>
        <p class="plat-card__desc">Native capture on any monitor, hardware H.264 MP4 via NVENC, Quick Sync or AMF, plus optimised GIF export.</p>
        <div class="plat-card__actions">
          <Button href={exe?.url ?? SITE.latestUrl} icon="windows" size="lg" data-dl="exe">
            Download .exe · <span data-dl-size="exe">{mb(exe?.size) || '8 MB'}</span>
          </Button>
          <Button href={msi?.url ?? SITE.latestUrl} variant="secondary" size="md" data-dl="msi">
            .msi installer · <span data-dl-size="msi">{mb(msi?.size) || '11 MB'}</span>
          </Button>
        </div>
      </section>

      <section class="plat-card studio-surface" aria-labelledby="mac-h">
        <div class="plat-card__head">
          <span class="plat-card__icon"><Icon name="apple" size={20} /></span>
          <div>
            <h2 id="mac-h" class="h4">macOS 14+</h2>
            <p class="mono">APPLE SILICON · SCREENCAPTUREKIT + METAL</p>
          </div>
        </div>
        <p class="plat-card__desc">Full Retina capture via ScreenCaptureKit, Metal GPU compositing, AVFoundation hardware H.264, and offline whisper.cpp.</p>
        <div class="plat-card__actions">
          <Button href={dmg?.url ?? SITE.latestUrl} icon="apple" size="lg" data-dl="dmg">
            Download .dmg · <span data-dl-size="dmg">{mb(dmg?.size) || '11 MB'}</span>
          </Button>
          <Button href={SITE.releasesUrl} variant="secondary" icon="external" size="md">
            All releases
          </Button>
        </div>
      </section>
    </div>

    <p class="ver">
      Version <span data-dl-version>{r.version}</span>{r.date && ` · ${humanDate(r.date)}`} ·
      <a class="link" href={url('/changelog/')}>What is new</a> ·
      <a class="link" href={SITE.releasesUrl} rel="noopener">Checksums &amp; GitHub Releases</a>
    </p>

    <section class="block" aria-labelledby="install-h">
      <h2 id="install-h" class="h3">Install in three steps.</h2>
      <ol class="steps" role="list">
        <li><span class="n mono">01</span><p>Open the downloaded <code>.exe</code> (Windows) or drag Vuoom from the <code>.dmg</code> to Applications (macOS).</p></li>
        <li><span class="n mono">02</span><p>On first launch: Windows SmartScreen requires <strong>More info</strong> then <strong>Run anyway</strong>; macOS requires right-click then <strong>Open</strong>.</p></li>
        <li><span class="n mono">03</span><p>Open Vuoom, grant capture access if prompted, and press <strong>Record</strong>.</p></li>
      </ol>
    </section>

    <section class="block" aria-labelledby="req-h">
      <h2 id="req-h" class="h3">What you need.</h2>
      <dl class="req">
        <div><dt>Windows</dt><dd>Windows 10 (1809 or later) or Windows 11, 64-bit. Windows 11 gives borderless window capture.</dd></div>
        <div><dt>macOS</dt><dd>macOS 14 Sonoma or newer on Apple Silicon (M1 or later).</dd></div>
        <div><dt>Graphics</dt><dd>Modern GPU with wgpu support. MP4 export uses NVENC, Quick Sync, AMF or Apple VideoToolbox.</dd></div>
        <div><dt>Internet</dt><dd>Not needed to record. Only for update checks and the one-time 57 MB captions model.</dd></div>
      </dl>
    </section>
  </div>

  <section class="section" aria-labelledby="film-h">
    <div class="wrap film-wrap">
      <h2 id="film-h" class="h3 center">See it first.</h2>
      <Film />
    </div>
  </section>

  <section class="section" aria-labelledby="faq-h" style="padding-top:0">
    <div class="wrap narrow">
      <h2 id="faq-h" class="h3 center">Install questions.</h2>
      <Faq items={faq} />
    </div>
  </section>
</Base>

<style>
  .narrow {
    max-width: calc(920px + var(--gutter) * 2);
  }
  .elsewhere {
    margin-bottom: var(--s-7);
    padding: var(--s-5);
    text-align: center;
  }
  .elsewhere p {
    margin-top: var(--s-2);
    color: var(--ink-2);
  }
  .elsewhere-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--s-5);
    margin-top: var(--s-4);
  }
  .platforms {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-5);
    margin-bottom: var(--s-6);
  }
  .plat-card {
    padding: var(--s-6);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }
  .plat-card__head {
    display: flex;
    align-items: center;
    gap: var(--s-4);
  }
  .plat-card__icon {
    width: 44px;
    height: 44px;
    border-radius: var(--r-ui);
    display: grid;
    place-items: center;
    background: var(--tungsten-soft);
    color: var(--tungsten);
    border: var(--hair) solid var(--rule);
    flex: none;
  }
  .plat-card__head p {
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--ink-3);
    margin-top: 2px;
  }
  .plat-card__desc {
    color: var(--ink-2);
    font-size: 0.9375rem;
    flex: 1;
  }
  .plat-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    padding-top: var(--s-2);
  }
  .ver {
    text-align: center;
    color: var(--ink-3);
    font-size: 0.9375rem;
  }
  .ver .link {
    color: var(--ink-2);
  }
  .block {
    margin-top: var(--s-9);
  }
  .block h2 {
    margin-bottom: var(--s-6);
  }
  .steps {
    display: grid;
    gap: var(--s-4);
  }
  .steps li {
    display: flex;
    gap: var(--s-4);
    align-items: baseline;
    font-size: var(--step-1);
    line-height: var(--lh-sub);
    color: var(--ink-2);
  }
  .steps strong {
    color: var(--ink);
    font-weight: 560;
  }
  .n {
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    display: inline-grid;
    place-items: center;
    border-radius: var(--r-pill);
    font-size: 0.75rem;
    color: var(--tungsten);
    border: var(--hair) solid var(--rule-strong);
    background: var(--ground-well);
    transform: translateY(-2px);
  }
  .req div {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: var(--s-4);
    padding-block: var(--s-4);
    border-bottom: var(--hair) solid var(--rule);
  }
  .req dt {
    color: var(--ink);
    font-weight: 500;
  }
  .req dd {
    color: var(--ink-2);
  }
  .film-wrap {
    max-width: 1100px;
  }
  .center {
    text-align: center;
    margin-bottom: var(--s-7);
  }
  @media (max-width: 760px) {
    .platforms {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .req div {
      grid-template-columns: 1fr;
      gap: var(--s-1);
    }
  }
</style>
