---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Faq from '../components/Faq.astro';
import CameraPlayground from '../components/CameraPlayground.astro';
import CapabilityRibbon from '../components/CapabilityRibbon.astro';
import ScreeningRoom from '../components/ScreeningRoom.astro';
import StudioFinisher from '../components/StudioFinisher.astro';
import AudioCaptionsPanel from '../components/AudioCaptionsPanel.astro';
import ExportEstimator from '../components/ExportEstimator.astro';
import { Image } from 'astro:assets';
import closingBgDark from '../assets/studio/closing-bg-dark.webp';
import closingBgLight from '../assets/studio/closing-bg-light.webp';
import { FAQ_GENERAL } from '../data/faq';
import { SITE, absolute, url } from '../lib/site';
import { latest, mb } from '../lib/github';
import { softwareApp, faqPage } from '../lib/schema';
import '../styles/studio-home.css';

const r = await latest();
const faq = [FAQ_GENERAL[0], FAQ_GENERAL[1], FAQ_GENERAL[3], FAQ_GENERAL[5]];
const schema = [
  await softwareApp(),
  faqPage(faq),
  {
    '@type': 'VideoObject',
    name: 'Vuoom automatic zoom screen recording demo',
    description: 'A real browser screen recording with critically-damped automatic zoom and motion blur.',
    thumbnailUrl: absolute('/media/github-poster.jpg'),
    contentUrl: absolute('/media/github.mp4'),
    uploadDate: '2026-09-25T00:00:00Z',
    duration: 'PT18S',
  },
];
---
<Base path="/" schema={schema}>
  <!-- 1. Centered Minimalist Hero + Living Spring Camera Stage -->
  <CameraPlayground />

  <!-- 2. Quiet Single-Row Capability Pill Ribbon -->
  <CapabilityRibbon />

  <!-- 3. Dark Cinema Screening Room (Pure Real Takes) -->
  <ScreeningRoom />

  <!-- 4. Gallery Studio Finishing Bay -->
  <StudioFinisher />

  <!-- 6. Dual Interactive Studio Panels: RNNoise/Captions & Export Size Estimator -->
  <section class="dual-panels wrap" aria-label="Voice cleanup, offline captions and export estimator">
    <AudioCaptionsPanel />
    <ExportEstimator />
  </section>

  <!-- 7. Native Engine & Architecture Metrics Strip -->
  <section class="craft-sec wrap" aria-labelledby="craft-h">
    <div class="craft-head" data-reveal>
      <p class="eyebrow-tag mono">NATIVE ENGINE</p>
      <h2 id="craft-h">Built to stay light. Built never to lose a take.</h2>
      <p class="craft-lead">
        Capture, GPU compositing, and hardware encoding run natively in Rust while LZ4 deltas stream safely to disk.
      </p>
      <div class="craft-links">
        <a class="text-link" href={url('/open-source/')}>Explore the Rust architecture ↗</a>
        <a class="text-link" href={url('/guide/#projects')}>Projects &amp; recovery guide ↗</a>
      </div>
    </div>

    <div class="craft-metrics" data-reveal-stagger>
      <div class="craft-stat">
        <strong class="mono">&lt; 11 MB</strong>
        <span>Native Windows &amp; macOS installers</span>
      </div>
      <div class="craft-stat">
        <strong class="mono">0.00%</strong>
        <span>Rust host idle CPU when minimised</span>
      </div>
      <div class="craft-stat">
        <strong class="mono">4K 60 fps</strong>
        <span>Hardware GPU H.264 &amp; dithered GIF</span>
      </div>
      <div class="craft-stat">
        <strong class="mono">20× smaller</strong>
        <span>LZ4 XOR delta streaming to disk</span>
      </div>
    </div>
  </section>

  <!-- 8. Frequently Asked Questions -->
  <section class="faq-sec wrap" aria-labelledby="faq-title">
    <div class="faq-intro" data-reveal>
      <p class="eyebrow-tag mono">FAQ</p>
      <h2 id="faq-title">Good questions.<br />Clear answers.</h2>
      <a class="text-link" href={url('/faq/')}>Read all questions ↗</a>
    </div>
    <div data-reveal>
      <Faq items={faq} />
    </div>
  </section>

  <!-- 9. Closing Download Gate -->
  <section class="close-sec" aria-labelledby="close-h">
    <div class="close-bg" data-parallax-scroll aria-hidden="true">
      <Image
        src={closingBgDark}
        alt=""
        widths={[960, 1440, 1914]}
        sizes="100vw"
        loading="lazy"
        class="close-bg__dark"
      />
      <Image
        src={closingBgLight}
        alt=""
        widths={[960, 1440, 1914]}
        sizes="100vw"
        loading="lazy"
        class="close-bg__light"
      />
      <div class="close-bg__scrim"></div>
    </div>

    <div class="wrap">
      <div class="close-card studio-surface" data-reveal>
        <p class="eyebrow-tag mono">READY TO RECORD?</p>
        <h2 id="close-h">Your next crisp demo starts with one take.</h2>
        <p class="close-sub">
          Free under Apache-2.0 with no account or watermark. Pick your platform and record in seconds.
        </p>

        <div class="close-actions">
          <Button href={r.exe?.url ?? '/download/'} icon="windows" size="lg" data-dl="exe">
            Windows .exe · <span data-dl-size="exe">{mb(r.exe?.size) || '8 MB'}</span>
          </Button>
          <Button href={r.dmg?.url ?? '/download/'} variant="secondary" icon="apple" size="lg" data-dl="dmg">
            macOS .dmg · <span data-dl-size="dmg">{mb(r.dmg?.size) || '11 MB'}</span>
          </Button>
        </div>

        <div class="close-meta mono">
          <span>v<span data-dl-version>{r.version}</span></span>
          <a class="text-link" href={url('/download/')}>All installers (.msi, guide)</a>
          <a class="text-link" href={SITE.repoUrl} rel="noopener">GitHub source</a>
        </div>
      </div>
    </div>
  </section>
</Base>
